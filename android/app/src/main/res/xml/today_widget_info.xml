<?xml version="1.0" encoding="utf-8"?>
<!-- The app refreshes the widget whenever Today reloads; updatePeriodMillis
     is only a fallback (Android allows at most every 30 minutes). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/today_widget_description"
    android:initialLayout="@layout/today_widget"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:previewLayout="@layout/today_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
